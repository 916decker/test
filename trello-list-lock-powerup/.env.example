# Trello API Configuration
# Get your API key from: https://trello.com/app-key
TRELLO_API_KEY=your-trello-api-key-here

# Get your token by visiting this URL (replace YOUR-KEY with your API key):
# https://trello.com/1/authorize?expiration=never&scope=read,write&response_type=token&name=List%20Lock%20Power-Up&key=YOUR-KEY
TRELLO_TOKEN=your-trello-token-here

# Your server's public URL (where this app is hosted)
# Examples:
# - https://your-app.glitch.me
# - https://your-app.replit.app
# - https://your-app.onrender.com
CALLBACK_URL=https://your-app-url-here

# Webhook secret (optional - will auto-generate if not set)
WEBHOOK_SECRET=random-secret-string-here

# Port (optional - defaults to 3000)
PORT=3000
